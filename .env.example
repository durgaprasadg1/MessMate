# ---- Core --------------------------------------------------------------------
NODE_ENV=development
# Public https URL of the deployment (used for cookies, reset links, CSRF). https:// in production!
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# REQUIRED, >= 32 chars:  openssl rand -base64 48
NEXTAUTH_SECRET=
# Optional: extra allowed origins for state-changing requests (comma separated)
# ALLOWED_ORIGINS=https://admin.example.com
# Session lifetime in seconds (default 28800 = 8 h) and bcrypt cost (default 12)
# SESSION_MAX_AGE_SECONDS=28800
# BCRYPT_COST=12
# Tenant segment for Redis keys (server-side only)
# TENANT_ID=public

# ---- Supabase (server only: never expose the service-role key) ---------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Redis (cache + rate limiting; falls back to in-memory limits if absent) --
REDIS_URL=redis://localhost:6379

# ---- Razorpay ----------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_SECRET=
# Dashboard -> Webhooks -> URL: https://<your-domain>/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=

# ---- Cloudinary --------------------------------------------------------------
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=

# ---- Mail (Gmail app password) -----------------------------------------------
MAIL_USER=
MAIL_PASS=

# ---- Two-step verification ---------------------------------------------------
# Key used to encrypt TOTP secrets at rest (falls back to NEXTAUTH_SECRET). openssl rand -base64 48
MFA_ENCRYPTION_KEY=

# ---- Logging -----------------------------------------------------------------
# debug | info | warn | error | silent   (default: info in production)
LOG_LEVEL=info

# ---- Sockets (client) --------------------------------------------------------
# NEXT_PUBLIC_ENABLE_SOCKETS=true
